# --- Large datasets (see datasets/SUMMARY.md for download instructions) ---
datasets/**/*.csv
datasets/**/*.zip
datasets/fleet-monthly/2020/
datasets/fleet-monthly/2021/
datasets/fleet-monthly/2022/
datasets/fleet-monthly/2023/
datasets/fleet-monthly/2024/

# --- Generated parquet files (regenerate with convert_to_parquet.py) ---
examples/data/
*.parquet

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Flask ---
instance/
.flaskenv

# --- Tableau processed data (regenerate with prep_tableau_data.py / join_tables.py) ---
tableau/data/*.csv
tableau/data/joined/*.csv
tableau/*.twbx

# --- EJF source PDFs (too large for git, download from ejfoundation.org) ---
text/EJF/*.pdf

# --- GDELT raw/intermediate data ---
text/GDELT/*.csv
text/GDELT/_progress*.json
text/GDELT/raw/

# --- Report build artifacts ---
report/**/*.aux
report/**/*.log
report/**/*.out
report/**/*.synctex*
report/**/*.fls
report/**/*.fdb_latexmk
